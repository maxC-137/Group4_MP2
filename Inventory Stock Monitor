import java.util.Scanner;

public class InventoryStockMonitor {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int numProducts = 0;

        // loop
        while(true) {
            System.out.print("Enter number of products (1 to 8): ");
            if(scan.hasNextInt()) {
                numProducts = scan.nextInt();
                if(numProducts >= 1 && numProducts <= 8) {
                    break;
                }
            } else {
                scan.next();
            }
            System.out.println("Invalid! Enter 1 to 8.");
        }
        scan.nextLine();

        Product[] products = new Product[numProducts];

        // input
        for(int i = 0; i < numProducts; i++) {
            System.out.println("\nProduct " + (i + 1));
            System.out.print("Enter Product Code: ");
            String code = scan.nextLine();
            System.out.print("Enter Product Name: ");
            String name = scan.nextLine();
            System.out.print("Enter Unit Price: ");
            double price = scan.nextDouble();
            System.out.print("Enter Opening Stock: ");
            int stock = scan.nextInt();
            scan.nextLine();

            products[i] = new Product(code, name, price, stock);
        }

        System.out.print("\nEnter number of transactions: ");
        int numTrans = scan.nextInt();
        scan.nextLine();

        // transactions
        for(int t = 0; t < numTrans; t++) {
            System.out.print("\nEnter target Product Code: ");
            String targetCode = scan.nextLine();
            System.out.print("Transaction Type (R for Restock / S for Sell): ");
            char type = scan.next().toUpperCase().charAt(0);
            System.out.print("Enter quantity: ");
            int qty = scan.nextInt();
            scan.nextLine();

            Product foundProduct = null;
            // search
            for(int i = 0; i < products.length; i++) {
                if(products[i].getCode().equals(targetCode)) {
                    foundProduct = products[i];
                    break;
                }
            }

            if(foundProduct == null) {
                System.out.println("Error: Product " + targetCode + " not found!");
            } else {
                if(type == 'R') {
                    if(foundProduct.restock(qty)) {
                        System.out.println("Success! Restocked " + qty);
                    } else {
                        System.out.println("Restock failed! Quantity must be positive.");
                    }
                } else if(type == 'S') {
                    if(foundProduct.sell(qty)) {
                        System.out.println("Success! Sold " + qty);
                    } else {
                        System.out.println("Sale rejected! Insufficient stock or invalid quantity.");
                    }
                } else {
                    System.out.println("Invalid transaction type!");
                }
            }
        }

        System.out.println("\n--- INVENTORY SUMMARY ---");
        double totalInventoryValue = 0;
        for(int i = 0; i < products.length; i++) {
            double val = products[i].getInventoryValue();
            totalInventoryValue += val;
            String lowStockLabel = products[i].isLowStock() ? " [LOW STOCK]" : "";
            System.out.println("Code: " + products[i].getCode() + " | Name: " + products[i].getName() + " | Price: " + products[i].getPrice() + " | Stock: " + products[i].getStock() + " | Value: " + val + lowStockLabel);
        }

        System.out.println("\nTotal Inventory Value: " + totalInventoryValue);
        System.out.println("Total Product objects created: " + Product.getProductCount());
        scan.close();
    }
}

class Product {
    private String code;
    private String name;
    private double price;
    private int stock;
    private static int productCount = 0;

    // constructor
    public Product(String code, String name, double price, int stock) {
        this.code = code;
        this.name = name;
        if(price >= 0) {
            this.price = price;
        } else {
            this.price = 0;
        }
        if(stock >= 0) {
            this.stock = stock;
        } else {
            this.stock = 0;
        }
        productCount++;
    }

    public String getCode() {
        return code;
    }

    public String getName() {
        return name;
    }

    public double getPrice() {
        return price;
    }

    public int getStock() {
        return stock;
    }

    // restock
    public boolean restock(int quantity) {
        if(quantity > 0) {
            stock += quantity;
            return true;
        }
        return false;
    }

    // sell
    public boolean sell(int quantity) {
        if(quantity > 0 && quantity <= stock) {
            stock -= quantity;
            return true;
        }
        return false;
    }

    public double getInventoryValue() {
        return price * stock;
    }

    public boolean isLowStock() {
        return stock <= 5;
    }

    public static int getProductCount() {
        return productCount;
    }
}
