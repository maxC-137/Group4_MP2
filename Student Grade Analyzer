package com.mycompany.studentgradeanalyzer;
import java.util.Scanner;

class Student {
private String id;
private String name;
private int[] scores;
private static int studentCount = 0;
public Student(String id, String name, int[] scores) {
this.id = id;
this.name = name;
this.scores = scores;
studentCount++;
}
public String getId() {
return id;
}
public String getName() {
return name;
}
public int[] getScores() {
return scores;
}
public double getAverage() {
int sum = 0;
for(int i=0; i<scores.length; i++) {
sum += scores[i];
}
return (double)sum / scores.length;
}
public String getStatus() {
return getAverage() >= 75 ? "PASSED" : "FAILED";
}
public static int getStudentCount() {
return studentCount;

}
}
public class StudentGradeAnalyzer {
    
public static void main(String[] args) {
Scanner scanner = new Scanner(System.in);
int numStudents = 0;
while(true) {
System.out.print("Enter number of students (1 to 10): ");
if(scanner.hasNextInt()) {
numStudents = scanner.nextInt();
if(numStudents >= 1 && numStudents <= 10) {
break;
}
} else {
scanner.next();
}
System.out.println("Invalid input. Please enter a number between 1 and 10.");
}
scanner.nextLine();
Student[] students = new Student[numStudents];
for(int i=0; i<numStudents; i++) {
System.out.println("\nEntering details for Student " + (i + 1) + " of " + numStudents);
System.out.print("Enter Student ID: ");
String id = scanner.nextLine();
System.out.print("Enter Full Name: ");
String name = scanner.nextLine();
int[] scores = new int[3];
for(int j=0; j<3; j++) {
while(true) {
System.out.print("Enter score " + (j + 1) + " (0 to 100): ");
if(scanner.hasNextInt()) {
int score = scanner.nextInt();
if(score >= 0 && score <= 100) {
scores[j] = score;
break;
}
} else {
scanner.next();
}
System.out.println("Invalid score. Scores must be between 0 and 100.");
}
}
scanner.nextLine();
students[i] = new Student(id, name, scores);
}
System.out.println("\nSTUDENT SUMMARY TABLE");
System.out.printf("%-10s %-20s %-12s %-10s\n", "ID", "Name", "Average", "Status");
Student highestStudent = students[0];
for(int i=0; i<students.length; i++) {
System.out.printf("%-10s %-20s %-12.2f %-10s\n", students[i].getId(), students[i].getName(), students[i].getAverage(), students[i].getStatus());
if(students[i].getAverage() > highestStudent.getAverage()) {
highestStudent = students[i];
}
}
System.out.println("\nHighest-Average Student: " + highestStudent.getName() + " with average " + highestStudent.getAverage());
System.out.println("Total Student objects created: " + Student.getStudentCount());
scanner.close();
}
}
