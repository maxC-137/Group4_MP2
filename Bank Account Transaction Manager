package com.mycompany.transactionmanager;
import java.util.Scanner;

 
class BankAccount {
private String accountNumber;
private String ownerName;
private double balance;
private static int accountCount = 0;
 
//constructor
public BankAccount(String accountNumber, String ownerName, double openingBalance) {
this.accountNumber = accountNumber;
this.ownerName = ownerName;
if(openingBalance >= 0) {
this.balance = openingBalance;
} else {
this.balance = 0;
}
accountCount++;
}
 
public String getAccountNumber() {
return accountNumber;
}
 
public String getOwnerName() {
return ownerName;
}
 
public double getBalance() {
return balance;
}
 
//deposit
public boolean deposit(double amount) {
if(amount > 0) {
balance += amount;
return true;
}
return false;
}
 
//withdraw
public boolean withdraw(double amount) {
if(amount > 0 && amount <= balance) {
balance -= amount;
return true;
}
return false;
}
 
public static int getAccountCount() {
return accountCount;
}
}
 
public class TransactionManager {
public static void main(String[] args) {
Scanner scan = new Scanner(System.in);
int numAccounts = 0;
 
//loop
while(true) {
System.out.print("Enter number of accounts (1 to 5): ");
if(scan.hasNextInt()) {
numAccounts = scan.nextInt();
if(numAccounts >= 1 && numAccounts <= 5) {
break;
}
} else {
scan.next();
}
System.out.println("Invalid! Enter 1 to 5.");
}
scan.nextLine();
 
BankAccount[] accounts = new BankAccount[numAccounts];
 
for(int i = 0; i < numAccounts; i++) {
System.out.println("\nAccount " + (i + 1));
System.out.print("Enter Account Number: ");
String accNum = scan.nextLine();
System.out.print("Enter Owner Name: ");
String name = scan.nextLine();
System.out.print("Enter Opening Balance: ");
double bal = scan.nextDouble();
scan.nextLine();
 
accounts[i] = new BankAccount(accNum, name, bal);
}
 
System.out.print("\nEnter number of transactions: ");
int numTrans = scan.nextInt();
scan.nextLine();
 
//transactions
for(int t = 0; t < numTrans; t++) {
System.out.print("\nEnter target Account Number: ");
String targetAcc = scan.nextLine();
System.out.print("Transaction Type (D for Deposit / W for Withdrawal): ");
char type = scan.next().toUpperCase().charAt(0);
System.out.print("Enter amount: ");
double amt = scan.nextDouble();
scan.nextLine();
 
BankAccount foundAccount = null;
for(int i = 0; i < accounts.length; i++) {
if(accounts[i].getAccountNumber().equals(targetAcc)) {
foundAccount = accounts[i];
break;
}
}
 
if(foundAccount == null) {
System.out.println("Error: Account " + targetAcc + " not found!");
} else {
if(type == 'D') {
if(foundAccount.deposit(amt)) {
System.out.println("Success! Deposited " + amt);
} else {
System.out.println("Deposit failed! Amount must be positive.");
}
} else if(type == 'W') {
if(foundAccount.withdraw(amt)) {
System.out.println("Success! Withdrew " + amt);
} else {
System.out.println("Withdrawal rejected! Insufficient funds or invalid amount.");
}
} else {
System.out.println("Invalid transaction type!");
}
}
}
 
System.out.println("\n--- FINAL BALANCES ---");
for(int i = 0; i < accounts.length; i++) {
System.out.println("Account: " + accounts[i].getAccountNumber() + " | Owner: " + accounts[i].getOwnerName() + " | Balance: " + accounts[i].getBalance());
}
 
System.out.println("Total accounts created: " + BankAccount.getAccountCount());
scan.close();
}
}
